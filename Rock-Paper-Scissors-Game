
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int user, computer;

    srand(time(0));

    printf("===== ROCK PAPER SCISSORS =====\n");

    while (1) {
        printf("\n1. Rock\n");
        printf("2. Paper\n");
        printf("3. Scissors\n");
        printf("4. Exit\n");

        printf("\nEnter your choice: ");
        scanf("%d", &user);

        if (user == 4) {
            printf("Thanks for playing!\n");
            break;
        }

        if (user < 1 || user > 3) {
            printf("Invalid choice! Try again.\n");
            continue;
        }

        computer = rand() % 3 + 1;

        printf("\nYou chose: ");
        if (user == 1) printf("Rock\n");
        else if (user == 2) printf("Paper\n");
        else printf("Scissors\n");

        printf("Computer chose: ");
        if (computer == 1) printf("Rock\n");
        else if (computer == 2) printf("Paper\n");
        else printf("Scissors\n");

        if (user == computer) {
            printf("\nResult: Draw!\n");
        }
        else if ((user == 1 && computer == 3) ||
                 (user == 2 && computer == 1) ||
                 (user == 3 && computer == 2)) {
            printf("\nResult: You Win!\n");
        }
        else {
            printf("\nResult: Computer Wins!\n");
        }
    }

    return 0;
}
